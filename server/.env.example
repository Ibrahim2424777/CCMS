# --- Local development values (copy this file to server/.env and edit) ---
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:your_password@localhost:5432/ccms_dev
DB_SSL=false
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace_with_a_long_random_string
SESSION_MAX_AGE_MS=43200000

# --- Production values (set these in your hosting provider's dashboard,
#     never in a committed file - see DEPLOYMENT.md) ---
# NODE_ENV=production
# PORT=                              # usually provided automatically by the host - leave unset
# DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require   # from your Postgres provider (e.g. Neon)
# DB_SSL=true                        # required by Neon/Supabase/most managed Postgres
# CORS_ORIGIN=https://your-frontend.pages.dev   # exact production frontend URL, no trailing slash
# SESSION_SECRET=                    # generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_MAX_AGE_MS=43200000

# --- One-time production bootstrap only (do not set persistently) ---
# Used by `npm run db:seed-admin` to create the first ADMIN login on a fresh
# production database. Remove/rotate ADMIN_PASSWORD after running once.
# ADMIN_NAME=Your Name
# ADMIN_EMAIL=admin@yourdomain.example
# ADMIN_PASSWORD=a-real-strong-password
