{
  "name": "ccms-server",
  "version": "0.1.0",
  "private": true,
  "description": "CCMS backend - Node.js/Express API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/db/migrate.js",
