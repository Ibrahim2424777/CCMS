# Local development
VITE_API_BASE_URL=http://localhost:5000/api

# Production (set as a build-time environment variable in your static host's
# dashboard - e.g. Cloudflare Pages - NOT in a committed file; Vite bakes this
# in at build time, so it must be set before the production build runs):
#
# VITE_API_BASE_URL=/api
#
# A relative path, NOT the backend's own URL - functions/api/[[path]].js
# proxies it to the real backend server-side, so the browser only ever talks
# to one origin. This is required, not optional: without it, the session
# cookie is a cross-domain ("third-party") cookie, which Safari blocks by
# default and Chrome/Firefox increasingly do too, regardless of the
# SameSite attribute - login appears to succeed and then immediately bounces
# back out, inconsistently across browsers/devices.
